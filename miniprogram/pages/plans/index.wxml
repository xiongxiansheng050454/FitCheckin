<view class="page tab-page">
 <view class="row between"><view class="heading">训练计划</view><view class="row"><button class="primary small-button" bindtap="cycle">安排周期</button><button class="primary small-button" aria-label="打开动作库" bindtap="exercises">动作库</button></view></view><view class="muted sync-label">{{syncLabel}}</view>
 <view class="segmented"><view class="segment {{view === 'cycles' ? 'active' : ''}}" data-view="cycles" bindtap="switchView">周期安排</view><view class="segment {{view === 'cycleTemplates' ? 'active' : ''}}" data-view="cycleTemplates" bindtap="switchView">周期模板</view><view class="segment {{view === 'templates' ? 'active' : ''}}" data-view="templates" bindtap="switchView">周模板</view></view>
 <block wx:if="{{view === 'cycles'}}">
  <view wx:if="{{legacy}}" class="notice">当前仍使用原来的每周循环。安排第一个周期后，将在它开始时切换。</view><view wx:if="{{needsNext}}" class="notice">已到最后一周，可以安排下一段周期了。</view><view wx:if="{{ended}}" class="notice">上一段周期已到期，下一程由你安排。</view>
  <view wx:for="{{cycles}}" wx:key="id" class="list-item"><view class="row between"><view class="grow subheading">{{item.name}}</view><text class="badge">{{item.status}}</text></view><view class="muted">{{item.startWeek}} 至 {{item.end}} · {{item.weekCount}} 周</view><view class="cycle-stages break">{{item.stages}}</view><view class="row wrap"><button class="secondary small-button" data-id="{{item.id}}" bindtap="cycle">查看 / 调整</button><button wx:if="{{item.canDelete}}" class="text-button small-button danger" data-id="{{item.id}}" bindtap="cancelCycle">取消周期</button></view></view>
  <view wx:if="{{!cycles.length}}" class="empty"><view class="empty-title">安排下一段训练</view><view class="muted">每一周，按自己的节奏来。</view><view class="actions"><button class="primary" bindtap="cycle">安排第一个周期</button></view></view>
  <view class="section"><view class="row between section-title"><text class="subheading">{{weekName}}</text><text wx:if="{{hasOverride}}" class="badge">已调整</text></view><picker mode="date" value="{{week}}" start="{{currentWeek}}" bindchange="chooseWeek"><view class="select row between"><text>{{week}} 起</text><text class="muted">选择周 ⌄</text></view></picker><view wx:if="{{hasWeek}}" class="actions"><button class="secondary" bindtap="week">调整此周动作</button><button wx:if="{{hasOverride}}" bindtap="resetWeek">恢复安排</button></view><view wx:else class="muted" style="margin-top:16rpx">这一周尚未安排</view></view>
 </block>
 <block wx:elif="{{view === 'cycleTemplates'}}">
  <view class="row between section-title template-title"><text class="subheading">我的周期模板</text><button class="small-button secondary" bindtap="createCycleTemplate">新建</button></view>
  <view wx:for="{{cycleTemplates}}" wx:key="id" class="list-item"><view class="row between"><view class="grow subheading" data-id="{{item.id}}" bindtap="editCycleTemplate">{{item.name}}</view><text class="badge">{{item.weekCount}} 周</text></view><view class="cycle-stages break">{{item.stages}}</view><view wx:if="{{item.missing}}" class="notice error">有周模板已删除，请编辑并替换后再安排。</view><view class="row wrap"><button class="secondary small-button" data-id="{{item.id}}" bindtap="arrangeCycleTemplate" disabled="{{item.missing || !identityReady}}">安排到周期</button><button class="small-button" data-id="{{item.id}}" bindtap="editCycleTemplate">编辑</button><button class="small-button" data-id="{{item.id}}" bindtap="copyCycleTemplate">复制</button><button class="text-button small-button danger" data-id="{{item.id}}" bindtap="removeCycleTemplate">删除</button></view></view>
  <view wx:if="{{!cycleTemplates.length}}" class="empty"><view class="empty-title">保存你的训练节奏</view><view class="muted">例如：轻度 × 4周 → 中度 × 4周</view><view class="actions"><button class="primary" bindtap="createCycleTemplate">新建周期模板</button></view></view>
 </block>
 <block wx:else>
  <view class="row between section-title template-title"><text class="subheading">我的周模板</text><button class="small-button secondary" bindtap="create">新建</button></view>
  <view wx:for="{{templates}}" wx:key="id" class="list-item"><view class="subheading break" data-id="{{item.id}}" bindtap="edit">{{item.name}}</view><view class="muted">{{item.dayCount}} 个训练日 · {{item.exerciseCount}} 个动作</view><view class="row wrap" style="margin-top:16rpx"><button class="secondary small-button" data-id="{{item.id}}" bindtap="arrange">安排到周期</button><button class="small-button" data-id="{{item.id}}" bindtap="edit">编辑</button><button class="small-button" data-id="{{item.id}}" bindtap="copy">复制</button><button class="text-button small-button danger" data-id="{{item.id}}" bindtap="remove">删除</button></view></view>
  <view wx:if="{{!templates.length}}" class="empty"><view class="empty-title">你的第一个训练周</view><view class="actions"><button class="primary" bindtap="create">新建周模板</button></view></view>
 </block>
</view>
