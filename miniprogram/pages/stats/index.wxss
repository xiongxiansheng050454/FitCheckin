.month-switch{margin-top:30rpx}.calendar{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:8rpx}.weekday{text-align:center;color:#6a756d;font-size:23rpx;padding:10rpx}.calendar-day{height:84rpx;display:flex;align-items:center;justify-content:center;flex-direction:column;border:2rpx solid transparent;border-radius:8rpx;background:#f5f7f5;gap:8rpx}.calendar-day.complete{background:#e7f4ec;color:#18864b}.calendar-day.partial{background:#fcf2de;color:#986218}.calendar-day.today{border-color:#18864b}.calendar-day.future{opacity:.35}.status-dot{width:7rpx;height:7rpx;border-radius:50%;background:transparent}.complete .status-dot{background:#18864b}.partial .status-dot{background:#c07a24}.legend{margin-top:20rpx;font-size:22rpx;color:#6a756d}.legend-dot{display:inline-block;width:12rpx;height:12rpx;border-radius:50%}.legend-dot.complete{background:#18864b}.legend-dot.partial{background:#c07a24}.chart{display:flex;gap:12rpx;margin-top:32rpx}.chart-column{flex:1;min-width:0;text-align:center}.chart-value{height:40rpx;font-size:19rpx;color:#6a756d;word-break:break-all}.chart-track{height:180rpx;background:#f1f5f2;position:relative;margin:10rpx 8rpx}.chart-bar{position:absolute;bottom:0;width:100%;background:#18864b;border-radius:4rpx 4rpx 0 0}
