<view class="page tab-page"><view class="row between"><view class="heading">训练统计</view><button class="secondary small-button" bindtap="poster" disabled="{{!trainingDays || !identityReady}}">生成海报</button></view><view class="row between month-switch"><button class="small-button" data-delta="-1" bindtap="month" aria-label="上个月">‹</button><picker mode="date" fields="month" value="{{month}}" bindchange="pickMonth"><view class="subheading">{{month}} ⌄</view></picker><button class="small-button" data-delta="1" bindtap="month" aria-label="下个月">›</button></view>
 <view class="metrics"><view class="metric"><view class="metric-value">{{totals.volume}}</view><view class="metric-label">估算容量 · kg</view></view><view class="metric"><view class="metric-value">{{trainingDays}}</view><view class="metric-label">训练日</view></view><view class="metric"><view class="metric-value">{{totals.completedCount}}</view><view class="metric-label">完成动作</view></view></view><view wx:if="{{change !== null}}" class="muted">较上月 {{change}}%</view>
 <view class="section"><view class="subheading section-title">训练日历</view><view class="calendar"><view wx:for="{{weekdayLabels}}" wx:key="*this" class="weekday">{{item}}</view><view wx:for="{{days}}" wx:key="date" class="calendar-day {{item.status}} {{item.today ? 'today' : ''}} {{item.future ? 'future' : ''}}" data-date="{{item.date}}" bindtap="openDay"><block wx:if="{{!item.blank}}"><text>{{item.day}}</text><view class="status-dot"></view></block></view></view><view class="legend row wrap"><text><text class="legend-dot complete"></text> 完成</text><text><text class="legend-dot partial"></text> 部分完成</text><text class="muted">今日用边框标记</text></view></view>
 <view class="segmented"><view class="segment {{mode === 'volume' ? 'active' : ''}}" data-mode="volume" bindtap="mode">容量趋势</view><view class="segment {{mode === 'muscles' ? 'active' : ''}}" data-mode="muscles" bindtap="mode">肌群分布</view><view class="segment {{mode === 'cardio' ? 'active' : ''}}" data-mode="cardio" bindtap="mode">有氧</view></view>
 <view wx:if="{{mode === 'volume'}}" class="section"><view class="subheading">近六个月</view><view class="chart"><view wx:for="{{trend}}" wx:key="month" class="chart-column"><view class="chart-value">{{item.volume}}</view><view class="chart-track"><view class="chart-bar" style="height:{{item.height}}%"></view></view><text class="muted">{{item.label}}月</text></view></view><view class="row between list-item"><text>力量容量</text><text>{{totals.weightedVolume}} kg</text></view><view class="row between list-item"><text>自重容量</text><text>{{totals.bodyweightVolume}} kg</text></view></view>
 <view wx:elif="{{mode === 'muscles'}}" class="section"><view class="subheading section-title">容量分布</view><view wx:for="{{muscles}}" wx:key="id" class="list-item"><view class="row between"><text>{{item.name}}</text><text>{{item.percentLabel}}% · {{item.volumeLabel}} kg</text></view><view class="bar-track"><view class="bar" style="width:{{item.percent}}%"></view></view></view><view wx:if="{{!muscles.length}}" class="empty muted">本月尚无肌群容量记录</view></view>
 <view wx:else class="section"><view class="subheading">本月有氧</view><view class="metrics"><view class="metric"><view class="metric-value">{{totals.cardioMinutes}}</view><view class="metric-label">分钟</view></view><view class="metric"><view class="metric-value">{{totals.cardioCount}}</view><view class="metric-label">完成次数</view></view></view></view><view wx:if="{{!trainingDays}}" class="notice">本月尚无完成的训练记录</view></view>
