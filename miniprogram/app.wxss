page { background:#fff; color:#17211c; font-family:"PingFang SC",sans-serif; font-size:28rpx; }
view,text,button,input { box-sizing:border-box; }
button { font-size:28rpx; border-radius:10rpx; margin:0; line-height:1.4; padding:22rpx 28rpx; background:#eef4f0; color:#17211c; }
button::after { border:0; }
button[disabled] { opacity:.45; }
.page { padding:32rpx 32rpx 64rpx; }
.tab-page { padding-bottom:170rpx; }
.heading { font-size:46rpx; font-weight:700; line-height:1.25; }
.subheading { font-size:32rpx; font-weight:650; word-break:break-all; }
.muted { color:#6a756d; font-size:25rpx; line-height:1.65; }
.eyebrow { color:#18864b; font-size:23rpx; font-weight:600; margin-bottom:12rpx; }
.row { display:flex; align-items:center; gap:20rpx; }
.between { justify-content:space-between; }
.grow { flex:1; min-width:0; }
.wrap { flex-wrap:wrap; }
.section { margin-top:40rpx; padding-top:32rpx; border-top:1rpx solid #e8eee9; }
.section-title { margin-bottom:24rpx; }
.primary { background:#18864b; color:#fff; }
.secondary { background:#eef4f0; color:#18864b; }
.danger { color:#b94035; background:#fff0ee; }
button.small-button { width:auto !important; min-width:64rpx; margin:0; flex:none; white-space:nowrap; font-size:25rpx; padding:14rpx 20rpx; }
.text-button { background:transparent; color:#18864b; padding:16rpx 8rpx; }
.badge { display:inline-block; padding:6rpx 14rpx; background:#eef4f0; color:#18864b; font-size:22rpx; border-radius:6rpx; white-space:nowrap; flex-shrink:0; }
.notice { background:#f7f3eb; color:#80591f; padding:22rpx; border-radius:10rpx; margin-top:24rpx; line-height:1.6; font-size:25rpx; }
.error { background:#fff0ee; color:#a53830; }
.empty { padding:58rpx 4rpx; }
.empty-title { font-size:34rpx; font-weight:600; margin-bottom:16rpx; }
.list-item { padding:26rpx 0; border-bottom:1rpx solid #e8eee9; }
.metric { flex:1; min-width:0; }
.metric-value { font-size:40rpx; font-weight:700; line-height:1.3; word-break:break-all; }
.metric-label { font-size:23rpx; color:#6a756d; margin-top:8rpx; }
.metrics { display:flex; gap:20rpx; padding:28rpx 0; }
.progress { height:12rpx; background:#e8eee9; border-radius:6rpx; overflow:hidden; }
.progress-fill { height:100%; background:#18864b; }
.form-label { display:block; color:#6a756d; font-size:25rpx; margin-bottom:14rpx; }
.field { margin-top:28rpx; }
.input { min-height:84rpx; padding:18rpx 22rpx; background:#f4f7f4; border:1rpx solid #e4ebe5; border-radius:8rpx; width:100%; font-size:29rpx; }
.select { padding:24rpx 22rpx; background:#f4f7f4; border-radius:8rpx; }
.actions { display:flex; gap:16rpx; margin-top:32rpx; }
.actions button { flex:1; }
.segmented { display:flex; gap:8rpx; background:#f3f6f3; padding:6rpx; border-radius:10rpx; margin-top:24rpx; }
.segment { flex:1; text-align:center; padding:17rpx 4rpx; font-size:25rpx; border-radius:6rpx; }
.segment.active { background:#fff; color:#18864b; font-weight:650; }
.break { word-break:break-all; }
button.check { width:56rpx !important; min-width:56rpx; max-width:56rpx; height:56rpx; padding:0; display:flex; align-items:center; justify-content:center; border:2rpx solid #c6d3c9; border-radius:8rpx; background:#fff; font-size:32rpx; flex:0 0 56rpx; }
.check.checked { color:white; border-color:#18864b; background:#18864b; }
.done-name { color:#6a756d; text-decoration:line-through; }
.bar-track { height:14rpx; background:#edf2ee; margin-top:12rpx; }
.bar { height:100%; background:#18864b; }
.bottom-space { height:24rpx; }
