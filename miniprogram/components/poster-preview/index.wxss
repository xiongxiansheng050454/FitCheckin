:host { font-family:"PingFang SC",sans-serif; }
.poster-overlay { position:fixed; inset:0; z-index:1001; background:#f4f7f4; display:flex; flex-direction:column; color:#17211c; }
.poster-toolbar { padding:18rpx 28rpx; display:flex; align-items:center; justify-content:space-between; background:#fff; flex:none; }
.poster-heading { font-size:30rpx; font-weight:700; }
button.close-button { width:72rpx !important; height:72rpx; margin:0; padding:0; line-height:72rpx; border-radius:8rpx; font-size:44rpx; background:#eef4f0; color:#17211c; }
button::after { border:0; }
.poster-scroll { flex:1; min-height:0; height:0; width:100%; }
.caption { margin:0 28rpx; padding:24rpx 0; font-size:26rpx; line-height:1.6; display:flex; align-items:center; justify-content:space-between; gap:20rpx; }
.caption text:first-child { min-width:0; word-break:break-all; }
.caption-arrow { flex:none; color:#18864b; font-size:32rpx; }
.poster-image { display:block; width:calc(100% - 56rpx); margin:0 28rpx 28rpx; }
.poster-actions { padding:20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom)); background:#fff; display:flex; gap:16rpx; flex:none; }
.poster-actions button { flex:1; min-width:0; width:auto !important; padding:24rpx 12rpx; margin:0; border-radius:8rpx; font-size:25rpx; line-height:1.5; font-weight:600; }
.save-button { background:#eef4f0; color:#18864b; }
.share-button { background:#18864b; color:#fff; }
button[disabled] { opacity:.45; }
.poster-error { margin:24rpx 28rpx; font-size:26rpx; color:#a53830; line-height:1.6; }
.poster-error button { margin-top:20rpx; color:#18864b; background:#eef4f0; border-radius:8rpx; }
.pending { padding:0 28rpx 28rpx; font-size:23rpx; color:#6a756d; }
.poster-canvas { position:fixed; left:-10000px; top:0; width:375px; height:660px; pointer-events:none; }
.instant-preview { margin:0 28rpx 28rpx; padding:48rpx 32rpx; min-height:680rpx; background:#111510; display:flex; flex-direction:column; color:#fff; }
.instant-brand { font-size:52rpx; font-weight:900; }
.instant-label { margin-top:60rpx; font-size:24rpx; color:#b4beb0; }
.instant-value { font-size:108rpx; line-height:1.2; font-weight:900; color:#d8ff3e; word-break:break-all; margin-top:16rpx; }
.instant-caption { margin-top:48rpx; font-size:34rpx; font-weight:700; line-height:1.6; }
.preparing { color:#b4beb0; font-size:24rpx; margin-top:24rpx; }
.preparing-line { height:6rpx; margin-top:60rpx; background:#d8ff3e; animation:breathe 1.6s ease-in-out infinite; }
@keyframes breathe { 50% { opacity:.35; } }
