.tab-bar{position:fixed;bottom:0;left:0;right:0;display:flex;background:#fff;border-top:1rpx solid #e8eee9;padding:12rpx 24rpx calc(12rpx + env(safe-area-inset-bottom));z-index:10}.tab{flex:1;border:0;background:#fff;font-size:28rpx;color:#6a756d;line-height:70rpx;margin:0;padding:0;border-radius:0}.tab::after{border:0}.selected{color:#18864b;font-weight:650}.indicator{width:28rpx;height:5rpx;background:#18864b;margin:0 auto;border-radius:4rpx}
