<view class="page"><view class="eyebrow">{{isWeek ? week + ' 起' : '周模板'}}</view><view class="heading">{{isWeek ? '本周安排' : '编辑周模板'}}</view><view wx:if="{{isWeek}}" class="notice">今日已开始训练时，保存后请回“今日”点击“更新今日清单”；已完成组数和动作参数会保留。历史记录不变。</view><view wx:else class="field"><text class="form-label">模板名称</text><input class="input" value="{{name}}" maxlength="60" bindinput="nameInput" placeholder="例如：轻度 · 三日" /></view><view wx:if="{{error}}" class="notice error">{{error}}</view>
 <button wx:if="{{stale}}" class="secondary" style="margin-top:18rpx" bindtap="loadLatest">重新加载最新版本</button><scroll-view scroll-x class="days-scroll"><view class="days"><view wx:for="{{days}}" wx:key="index" class="day {{dayIndex === index ? 'selected' : ''}}" data-index="{{index}}" bindtap="chooseDay"><view>{{item.label}}</view><view class="day-count">{{item.count ? item.count + ' 动作' : '休息'}}</view></view></view></scroll-view>
 <view class="row between section-title"><text class="subheading">{{days[dayIndex].label}}</text><view class="row"><button class="text-button small-button" bindtap="copyDay">复制到</button><button class="text-button small-button" bindtap="rest">休息日</button></view></view>
 <view wx:for="{{items}}" wx:key="entryId" class="list-item"><view class="row" data-index="{{index}}" bindtap="editEntry"><text class="order">{{index + 1}}</text><view class="grow"><view class="subheading">{{item.name}}</view><view class="muted">{{item.summary}}</view></view><text class="muted">›</text></view><view class="row wrap entry-tools"><button class="small-button" data-index="{{index}}" data-delta="-1" bindtap="move" disabled="{{index === 0}}" aria-label="上移">↑</button><button class="small-button" data-index="{{index}}" data-delta="1" bindtap="move" disabled="{{index === items.length - 1}}" aria-label="下移">↓</button><button class="text-button small-button" data-index="{{index}}" bindtap="editEntry">参数</button><button class="text-button small-button" data-index="{{index}}" bindtap="copyEntry">复制</button><button class="text-button small-button" style="color:#b94035" data-index="{{index}}" bindtap="remove">移除</button></view></view>
 <view wx:if="{{!items.length}}" class="empty"><view class="empty-title">休息日</view><view class="muted">此日尚未安排训练动作</view></view><view class="actions"><button class="secondary" bindtap="add">添加动作</button></view><view class="actions"><button class="primary" disabled="{{saving || !identityReady}}" loading="{{saving}}" bindtap="save">保存{{isWeek ? '本周安排' : '计划'}}</button></view><view wx:if="{{dirty}}" class="muted" style="margin-top:16rpx">有未保存的修改</view></view>
