<view class="page">
 <view class="eyebrow">{{isTemplate ? '周模板组成的训练周期' : weekCount ? weekCount + ' 周 · ' + startWeek + ' 至 ' + end : '新的训练周期'}}</view><view class="heading">{{isTemplate ? '编辑周期模板' : '逐周安排'}}</view>
 <view class="field"><text class="form-label">{{isTemplate ? '周期模板名称' : '周期名称'}}</text><input class="input" value="{{name}}" maxlength="60" bindinput="nameInput" placeholder="例如：8周渐进训练" /></view>
 <view wx:if="{{!isTemplate}}" class="field"><text class="form-label">起始周</text><picker mode="date" value="{{startWeek}}" start="{{currentWeek}}" disabled="{{started}}" bindchange="chooseStart"><view class="select row between"><text>{{startWeek}} · 周一</text><text class="muted">{{started ? '已开始' : '⌄'}}</text></view></picker></view>
 <view wx:if="{{canLoadCycleTemplate && cycleTemplateNames.length}}" class="field"><text class="form-label">从周期模板开始</text><picker range="{{cycleTemplateNames}}" bindchange="loadCycleTemplate"><view class="select row between"><text>选择周期模板</text><text class="muted">⌄</text></view></picker></view>
 <view wx:if="{{error}}" class="notice error">{{error}}</view><button wx:if="{{stale}}" class="secondary" bindtap="loadLatest">重新加载最新版本</button>
 <view class="section"><view class="subheading">添加训练周</view><view wx:if="{{templateNames.length}}" class="append-controls"><picker class="grow" range="{{templateNames}}" value="{{templateIndex}}" bindchange="chooseTemplate"><view class="select break">{{templateNames[templateIndex]}} ⌄</view></picker><view class="repeat"><input class="input" type="number" value="{{repeatCount}}" bindinput="repeatInput" maxlength="2" aria-label="连续添加周数" /><text class="muted">周</text></view><button class="primary small-button" bindtap="addWeeks">添加</button></view><view wx:else class="actions"><button class="secondary" bindtap="templates">新建周模板</button></view></view>
 <view class="section"><view class="row between section-title"><text class="subheading">{{weekCount}} 周安排</text><text class="muted">{{weekCount}} / 52</text></view>
  <view wx:for="{{rows}}" wx:key="index" class="week-row"><view class="row between"><view class="grow"><view class="subheading">第 {{item.number}} 周<text wx:if="{{item.current}}" class="badge current-badge">本周</text></view><view wx:if="{{!isTemplate}}" class="muted">{{item.week}} 至 {{item.end}}</view><view class="week-template break">{{item.name}} · {{item.dayCount}} 个训练日</view></view><text wx:if="{{item.locked}}" class="muted">已过去</text></view><view wx:if="{{!item.locked}}" class="row wrap week-tools"><picker wx:if="{{templateNames.length}}" range="{{templateNames}}" data-index="{{index}}" bindchange="replace"><view class="replace-template">更换模板 ⌄</view></picker><button class="small-button" data-index="{{index}}" data-delta="-1" bindtap="move" disabled="{{index === 0 || rows[index - 1].locked}}" aria-label="提前一周">↑</button><button class="small-button" data-index="{{index}}" data-delta="1" bindtap="move" disabled="{{index === rows.length - 1}}" aria-label="推后一周">↓</button><button class="danger small-button" data-index="{{index}}" bindtap="remove" aria-label="移除此周">×</button></view></view>
  <view wx:if="{{!rows.length}}" class="empty"><view class="muted">还没有安排训练周</view></view>
 </view>
 <view class="notice">{{isTemplate ? '周期模板引用周模板，安排时使用它们的最新参数。已排进日历的周期不受模板修改影响。' : '周安排保存为独立副本。以后修改周模板不会影响此周期；本周已开始的训练保留当天记录。'}}</view>
 <view class="actions"><button class="primary" bindtap="save" loading="{{saving}}" disabled="{{saving || !identityReady || !weekCount}}">{{isTemplate ? '保存周期模板' : '保存周期安排'}}</button></view><view wx:if="{{!isTemplate && weekCount}}" class="actions"><button class="secondary" bindtap="saveAsTemplate" disabled="{{saving || !identityReady}}">存为周期模板</button></view><view wx:if="{{dirty}}" class="muted" style="margin-top:16rpx">有未保存的安排</view>
</view>
