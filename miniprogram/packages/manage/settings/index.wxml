<view class="page"><view class="heading">我的</view><view class="section"><view class="subheading">当前体重</view><view class="field"><text class="form-label">体重 · kg</text><input class="input" type="digit" value="{{weight}}" focus="{{weightFocus}}" bindinput="input" placeholder="例如 70.0" /></view><view class="muted" style="margin-top:18rpx">自重容量按记录当天的体重计算；体重不会向其他用户公开</view><view class="actions"><button class="primary" bindtap="save" loading="{{saving}}" disabled="{{saving || !identityReady}}">保存体重</button></view></view>
 <view wx:if="{{error}}" class="notice error">{{error}}</view><button wx:if="{{stale}}" class="secondary" style="margin-top:18rpx" bindtap="loadLatest">重新加载最新体重</button><view wx:if="{{!identityReady}}" class="notice">{{loading ? '正在确认微信身份…' : '身份未确认，请连接网络后重试。'}}</view><view class="section"><view class="row between section-title"><text class="subheading">云端同步</text><text class="badge">{{syncLabel}}</text></view><view class="muted">待同步 {{pendingCount}} 项</view><view wx:if="{{syncMessage}}" class="notice {{syncStatus === 'error' ? 'error' : ''}}">{{syncMessage}}</view><view class="actions"><button class="secondary" bindtap="retry">重试同步</button><button bindtap="pull">刷新云端</button></view></view>
 <view wx:if="{{conflicts.length}}" class="section"><view class="subheading">处理冲突</view><view wx:for="{{conflicts}}" wx:key="id" class="list-item"><view class="subheading">{{item.kindName}}</view><view class="muted break">本地：{{item.localTitle}}</view><view class="muted break">云端：{{item.cloudTitle}}</view><button class="text-button small-button" data-index="{{index}}" bindtap="details">{{item.expanded ? '收起版本详情' : '查看版本详情'}}</button><view wx:if="{{item.expanded}}"><view class="form-label">本地版本</view><text class="version-detail">{{item.localDetail}}</text><view class="form-label" style="margin-top:24rpx">云端版本</view><text class="version-detail">{{item.cloudDetail}}</text></view><view class="actions"><button data-id="{{item.id}}" data-choice="cloud" bindtap="resolve">采用云端</button><button class="secondary" data-id="{{item.id}}" data-choice="local" bindtap="resolve">保留本地</button></view></view></view></view>
