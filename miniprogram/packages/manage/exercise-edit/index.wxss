.muscle-choice{min-width:190rpx;display:flex;align-items:center;font-size:25rpx;padding:8rpx 0}.muscle-choice checkbox{transform:scale(.8);margin-left:-8rpx}
.reps-heading{margin-bottom:8rpx}
.rpe-label{margin:0}.rpe-heading{gap:4rpx}.rpe-help{width:60rpx;height:60rpx;flex:none;display:flex;align-items:center;justify-content:center}.rpe-help-symbol{width:28rpx;height:28rpx;line-height:28rpx;border:2rpx solid #8a938d;border-radius:50%;font-size:21rpx;color:#8a938d;text-align:center}.rpe-value{font-size:30rpx;font-weight:700}.rpe-field slider{margin:20rpx 10rpx}.rpe-field>.muted{font-size:24rpx;gap:12rpx}
