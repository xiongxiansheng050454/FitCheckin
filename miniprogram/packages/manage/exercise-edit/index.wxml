<view class="page"><view class="eyebrow">{{entryMode ? '计划内动作参数' : '我的动作库'}}</view><view class="heading">编辑动作</view><view class="field"><text class="form-label">动作名称</text><input class="input" value="{{form.name}}" bindinput="name" maxlength="50" placeholder="动作名称" /></view><view class="field"><text class="form-label">训练类型</text><picker range="{{types}}" value="{{typeIndex}}" bindchange="type"><view class="select row between"><text>{{types[typeIndex]}}</text><text>⌄</text></view></picker></view>
 <view wx:for="{{fields}}" wx:key="key" class="field"><view wx:if="{{item.key === 'reps'}}" class="row rpe-heading reps-heading"><text class="form-label rpe-label">{{item.label}} · {{item.unit}}</text><view class="rpe-help" bindtap="repsHelp" aria-role="button" aria-label="了解总次数的填写方式"><text class="rpe-help-symbol">?</text></view></view><text wx:else class="form-label">{{item.label}} · {{item.unit}}</text><input class="input" type="digit" value="{{item.value}}" placeholder="{{item.placeholder || ''}}" data-key="{{item.key}}" bindinput="field" maxlength="60" /></view>
 <view class="field rpe-field"><view class="row between"><view class="row rpe-heading"><text class="form-label rpe-label">强度 · RPE</text><view class="rpe-help" bindtap="rpeHelp" aria-role="button" aria-label="了解RPE强度"><text class="rpe-help-symbol">?</text></view></view><text class="rpe-value">{{form.rpe}} / {{rpeRange.max}}</text></view><slider min="{{rpeRange.min}}" max="{{rpeRange.max}}" step="1" value="{{form.rpe}}" bindchanging="rpeChange" bindchange="rpeChange" activeColor="#18864b" backgroundColor="#e4ebe5" block-size="24" /><view class="row between muted"><text>{{rpeRange.min}}</text><text>{{rpeDescription}}</text><text>{{rpeRange.max}}</text></view></view>
 <view wx:if="{{form.type !== 'cardio'}}" class="section"><view class="subheading">肌群分配</view><view class="field"><text class="form-label">主要肌群</text><picker range="{{muscles}}" range-key="name" value="{{primaryIndex}}" bindchange="primary"><view class="select row between"><text>{{muscles[primaryIndex].name}}</text><text>⌄</text></view></picker></view><view class="field"><text class="form-label">次要肌群</text><checkbox-group bindchange="secondary"><view class="row wrap"><label wx:for="{{secondaryChoices}}" wx:key="id" class="muscle-choice"><checkbox value="{{item.id}}" checked="{{item.checked}}" color="#18864b" />{{item.name}}</label></view></checkbox-group></view><view wx:for="{{muscleRows}}" wx:key="id" class="field"><text class="form-label">{{item.role}} · {{item.name}} · %</text><input class="input" type="digit" value="{{item.percent}}" data-index="{{index}}" bindinput="percentage" /></view><view class="notice {{muscleTotal !== 100 ? 'error' : ''}}">合计 {{muscleTotal}} / 100%</view></view>
 <view wx:if="{{error}}" class="notice error">{{error}}</view><button wx:if="{{stale}}" class="secondary" style="margin-top:18rpx" bindtap="loadLatest">重新加载最新版本</button><view class="actions"><button class="primary" loading="{{saving}}" disabled="{{saving || !identityReady}}" bindtap="save">保存动作</button></view></view>
