<view class="page"><view class="row between"><view class="heading">{{manage ? '动作库' : '选择动作'}}</view><view class="row"><button class="primary small-button" bindtap="create">自定义</button><button wx:if="{{!componentMode}}" class="primary small-button" bindtap="createSuperset">超级组</button></view></view><view class="field"><input class="input" placeholder="搜索动作" value="{{query}}" bindinput="search" /></view><view class="segmented"><view wx:for="{{filters}}" wx:key="id" class="segment {{filter === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="filter">{{item.name}}</view></view><view wx:for="{{items}}" wx:key="id" class="list-item"><view class="row" data-id="{{item.id}}" bindtap="select"><view class="grow"><view class="subheading">{{item.name}}</view><view class="muted">{{item.summary}}</view></view><text class="badge">{{item.type === 'superset' ? item.typeLabel : item.custom ? '自定义' : item.typeLabel}}</text><text class="muted">›</text></view><view wx:if="{{manage}}" class="row" style="margin-top:12rpx"><button class="text-button small-button" data-id="{{item.id}}" bindtap="edit">{{item.custom ? '编辑' : '复制并编辑'}}</button><button wx:if="{{item.custom}}" class="text-button small-button" style="color:#b94035" data-id="{{item.id}}" bindtap="remove">删除</button></view></view><view wx:if="{{!items.length}}" class="empty"><view class="empty-title">没有匹配的动作</view><view class="muted">可添加自定义动作</view></view></view>
