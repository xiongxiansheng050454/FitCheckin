<view class="page"><view class="eyebrow">{{date}} · {{weekday}}</view><view class="row between"><view class="heading">训练记录</view><text class="badge">只读</text></view><view wx:if="{{error}}" class="notice error">{{error}}</view><block wx:if="{{exists}}"><view class="metrics"><view class="metric"><view class="metric-value">{{totals.volume}}</view><view class="metric-label">估算容量 · kg</view></view><view class="metric"><view class="metric-value">{{totals.completedSetCount}}<text class="muted"> / {{totals.totalSetCount}}</text></view><view class="metric-label">{{status}} · 组数</view></view></view><view wx:if="{{bodyWeight}}" class="muted">当日体重 {{bodyWeight}} kg</view><view class="section"><view class="subheading section-title">当日动作快照</view><view wx:for="{{items}}" wx:key="entryId" class="list-item row"><view class="check {{item.checked ? 'checked' : ''}}">{{item.checked ? '✓' : ''}}</view><view class="grow"><view class="subheading">{{item.name}}</view><view class="muted">{{item.summary}}</view><view class="muted">{{item.progress}}{{item.checked ? ' · 已完成' : ''}}</view></view></view></view><view class="section"><view class="row between"><text>有氧时长</text><text>{{totals.cardioMinutes}} 分钟</text></view></view></block><view wx:elif="{{!error}}" class="empty"><view class="empty-title">这天没有训练记录</view><text class="muted">休息日与未开始的训练不会产生记录</text></view></view>
